# Локально: cp .env.example .env
# Прод: GitHub Actions secrets → .github/workflows/main.yml (job deploy) (см. .github/workflows/main.yml)
#
# Вариант A — один секрет DOTENV (весь файл как на сервере)
# Вариант B — отдельные секреты (обязательны: POSTGRES_PASSWORD, REDIS_PASSWORD, MINIO_ROOT_PASSWORD)

APPLICATION_CONFIG=local

NGINX_PORT=8080
BACKEND_HOST=0.0.0.0
LOG_LEVEL=info

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=asap

S3_HOST=minio
S3_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=
S3_BUCKET=media
S3_USE_SSL=false
S3_PUBLIC_USE_SSL=true
S3_PUBLIC_HOST=pulseapp.space
S3_PUBLIC_PORT=443

VKID_CLIENT_ID=
VKID_REDIRECT_URI=https://pulseapp.space/chats
VKID_AUTH_URL=https://id.vk.ru/oauth2/auth
VKID_PUBLIC_INFO_URL=https://id.vk.ru/oauth2/public_info

PAYMENT_SECRET_KEY=
PAYMENT_SHOP_ID=
PAYMENT_RETURN_URL=

SPEECHKIT_API_KEY=

CAPYBARA_DETECTOR_ENABLED=true
CAPYBARA_SCORE_THRESHOLD=0.28
CAPYBARA_PYTHON=python3
